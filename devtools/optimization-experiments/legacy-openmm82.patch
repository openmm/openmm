+inline bool selectFraction(const char* value, double& fraction) {
+    fraction = 0.08;
+    if (value == nullptr || std::strcmp(value, "0") == 0 || std::strcmp(value, "0.08") == 0)
+        return true;
+    if (std::strcmp(value, "0.10") == 0) {
+        fraction = 0.10;
+        return true;
+    }
+    if (std::strcmp(value, "0.12") == 0) {
+        fraction = 0.12;
+        return true;
+    }
+    return false;
+}
